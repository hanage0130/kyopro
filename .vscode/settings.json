{
    "files.autoSave": "onFocusChange",
    "files.eol": "\n",
    "editor.tabSize": 4,
    "[cpp]": {
        "editor.tabSize": 2,
        "editor.quickSuggestions": {
            "other": "off",
            "comments": "off",
            "strings": "off"
